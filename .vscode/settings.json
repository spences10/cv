{
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.formatOnSave": true,
	"oxc.fmt.configPath": "./vite.config.ts",
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode",
		"editor.formatOnSave": true
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"git.enableSmartCommit": true,
	"git.postCommitCommand": "sync"
}
