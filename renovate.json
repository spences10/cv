{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"minimumReleaseAge": "2 days",
	"packageRules": [
		{
			"description": "Keep Svelte packages aligned across the workspace",
			"matchManagers": ["npm"],
			"matchPackageNames": [
				"/^@sveltejs\\//",
				"svelte",
				"svelte-check"
			],
			"groupName": "Svelte packages",
			"groupSlug": "svelte-packages"
		},
		{
			"description": "Keep installed Playwright packages aligned with the CI browser images.",
			"matchPackageNames": [
				"@playwright/test",
				"playwright",
				"mcr.microsoft.com/playwright"
			],
			"groupName": "playwright",
			"rangeStrategy": "pin"
		},
		{
			"description": "Group GitHub Actions updates",
			"matchManagers": ["github-actions"],
			"matchDatasources": ["github-tags", "github-releases"],
			"groupName": "GitHub Actions",
			"groupSlug": "github-actions"
		},
		{
			"description": "Keep the JavaScript compiler API on TypeScript 6 until SvelteKit supports TypeScript 7. The native compiler alias is separate.",
			"matchDepNames": ["typescript"],
			"allowedVersions": "<7"
		},
		{
			"description": "Update Vite+ and its aliased Vite core together; align bundled test dependencies when upgrading.",
			"matchPackageNames": [
				"vite-plus",
				"@voidzero-dev/vite-plus-core"
			],
			"groupName": "vite-plus-toolchain",
			"rangeStrategy": "pin"
		},
		{
			"description": "Managed by Vite+'s bundled Vitest version, not independent runner or plugin updates.",
			"matchPackageNames": ["vitest", "/^@vitest\\//"],
			"enabled": false
		}
	]
}
