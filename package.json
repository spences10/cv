{
	"name": "cv",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "node ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"test:ci": "vp test --run",
		"cspell": "cspell '**/*.md' --config cspell.json --wordsOnly",
		"snapshot:create": "npx tsx scripts/create-snapshot.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.3",
		"cspell": "^10.3.6",
		"daisyui": "5.7.47",
		"date-fns": "^4.4.0",
		"fathom-client": "^3.7.2",
		"mdsvex": "^0.12.8",
		"playwright": "1.64.0",
		"rehype-external-links": "^3.0.0",
		"svead": "^0.0.16",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"packageManager": "pnpm@12.9.1"
}
