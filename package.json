{
	"name": "cv",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:ci": "vitest run",
		"cspell": "cspell '**/*.md' --config cspell.json --wordsOnly",
		"snapshot:create": "npx tsx scripts/create-snapshot.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.34.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "next",
		"@sveltejs/kit": "3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^4.1.11",
		"cspell": "^10.1.1",
		"daisyui": "5.7.22",
		"date-fns": "^4.4.0",
		"fathom-client": "^3.7.2",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"rehype-external-links": "^3.0.0",
		"svead": "^0.0.16",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plus": "0.3.0",
		"vitest": "4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"packageManager": "pnpm@11.25.0"
}
